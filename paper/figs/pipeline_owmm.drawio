        <mxCell id="batch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#dbe7f3;strokeColor=#3a3a3a;strokeWidth=3;fontSize=36;" value="&lt;b&gt;Mini-batch&lt;/b&gt;&lt;br&gt;(X, y)&lt;br&gt;imbalanced" vertex="1">
