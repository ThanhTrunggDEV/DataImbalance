        <mxCell id="prior" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#f6d9b8;strokeColor=#3a3a3a;strokeWidth=3;fontSize=36;" value="&lt;b&gt;Tempered prior&lt;/b&gt;&lt;br&gt;z + γ·log n&lt;br&gt;γ ∈ [0, 1]" vertex="1">
